# Dependencies / build output (monorepo-wide)
node_modules/
pnpm-lock.yaml   # layihə npm işlədir (package-lock.json)
dist/
.next/
build/
coverage/

# ── WhatsApp (whatsapp-web.js) runtime ──
# ⚠️ .wwebjs_auth/ saxlanmış WhatsApp sessiyasıdır — onu əldə edən şəxs hesaba
# TAM giriş qazanır. Heç vaxt commit olunmamalıdır.
# (Naxış qovluğun harada olmasından asılı olmayaraq işləyir.)
.wwebjs_auth/
.wwebjs_cache/
session-*/

# Puppeteer / Chromium keşi (lokal yüklənən brauzer)
.cache/puppeteer/
.local-chromium/

# Runtime uploads
apps/api/uploads/

# Environment — never commit real secrets
.env
.env.*
!.env.example

