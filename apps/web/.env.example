# Base URL of the API server (no trailing slash). The RTK base query appends
# `/api` to this value, so point it at the server root.
#
# İSTEHSALATDA BOŞ SAXLA. Boş olanda brauzer nisbi `/api` yolunu işlədir və
# sorğu həmişə səhifə ilə eyni sxem/host-a gedir (nginx onu Express-ə ötürür).
# Nəticədə domen dəyişəndə yenidən build lazım gəlmir və HTTPS səhifədən HTTP
# ünvana sorğu (mixed content) mümkün olmur.
# Dev-də client :3000, API :5000-dədir, ona görə burada mütləq ünvan verilir.
NEXT_PUBLIC_API_URL=http://localhost:5000

# SSR üçün API ünvanı (server-only, NEXT_PUBLIC_ DEYİL). Server komponentləri
# nisbi yol ilə fetch edə bilmir, ona görə mütləq ünvan lazımdır.
# İstehsalatda birbaşa proses ünvanı verilir — sorğu nginx və Cloudflare
# dövrəsindən keçmir: həm sürətli, həm də domenin DNS/sertifikat vəziyyətindən
# asılı deyil. Məsələn: http://127.0.0.1:30002
API_INTERNAL_URL=

# Public site URL used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host that serves uploaded media (`/uploads/...`). Usually the same as the
# API server root. Used by the editor to build absolute image/file URLs.
# İstehsalatda boş saxla — şəkillər `/uploads/...` kimi nisbi qalır.
# Yalnız ayrıca CDN işlədilsə doldurulur.
NEXT_PUBLIC_IMAGE_URL=http://localhost:5000

# Optional: comma-separated legacy media hosts to rewrite to relative paths in
# stored editor HTML (e.g. http://old-host:5000,https://old.cdn.example.com).
NEXT_PUBLIC_LEGACY_IMAGE_HOSTS=
